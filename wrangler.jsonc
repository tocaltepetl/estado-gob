// Configuración de Cloudflare Workers: archivos estáticos de `public/`, un
// Worker para /api/* y un cron que revisa los sitios cada 5 minutos.
// Ver docs/decisiones.md.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "estado-gob",
	"main": "src/worker.js",
	"compatibility_date": "2026-11-10",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "estado-gob",
			// Creada con `wrangler d1 create estado-gob` (2026-11-13).
			"database_id": "8490480b-c185-4c42-8670-2cc23c733331",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		// Contra spam en POST /api/reporte: 10 por minuto por IP (la IP no se guarda).
		{"name": "LIMITE", "namespace_id": "1002", "simple": {"limit": 10, "period": 60}},
		// POST /api/solicitud abre issues públicos: 2 por minuto por IP, además de Turnstile.
		{"name": "LIMITE_SOLICITUD", "namespace_id": "1003", "simple": {"limit": 2, "period": 60}}
	],
	"routes": [
		{"pattern": "estado.tocaltepetl.org", "custom_domain": true}
	],
	// Secretos (no van aquí): TOKEN_REVISOR (revisor en México), GITHUB_TOKEN
	// (issues automáticos y solicitudes) y TURNSTILE_SECRET (antispam de /api/solicitud). En local van en .dev.vars.
	"workers_dev": false,
	"preview_urls": true
}
