// Configuración de Cloudflare Workers: archivos estáticos de `public/`, un
// Worker para /api/* y un cron que revisa los sitios cada 5 minutos.
// Ver docs/decisiones.md.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "estado-gob",
	"main": "src/worker.js",
	"compatibility_date": "2026-11-10",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "estado-gob",
			// Pendiente: `wrangler d1 create estado-gob` y poner aquí el id (etapa 2).
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// Secretos (no van aquí): TOKEN_REVISOR (revisor en México) y GITHUB_TOKEN
	// (issues automáticos). En local van en .dev.vars.
	"workers_dev": false,
	"preview_urls": true
}
